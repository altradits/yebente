# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://yebente.onrender.com)
APP_URL="https://yebente.onrender.com"

# Safaricom Daraja API Configuration
# Options: "sandbox" or "production"
MPESA_ENVIRONMENT="sandbox"

# Daraja OAuth Credentials (obtain from developer.safaricom.co.ke)
MPESA_CONSUMER_KEY="YOUR_MPESA_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="YOUR_MPESA_CONSUMER_SECRET"

# Lipa Na M-Pesa Online (STK Push) Settings
# Default sandbox test shortcode is 174379
MPESA_SHORTCODE="174379"

# Official Safaricom Sandbox Passkey
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"

# Webhook Callback URL (accessible by Safaricom servers). It must end in ?token= and
# the same value as MPESA_CALLBACK_TOKEN: callbacks without it are rejected.
MPESA_CALLBACK_TOKEN="A_LONG_RANDOM_STRING"
MPESA_CALLBACK_URL="https://yebente.onrender.com/api/mpesa/callback?token=A_LONG_RANDOM_STRING"

# Lightning Network Node Configuration (To receive/settle with Wallet of Satoshi)
# Option 1: LNbits Instance (e.g. self-hosted, Voltage, or demo)
LNBITS_URL="https://legend.lnbits.com"
LNBITS_INVOICE_KEY="YOUR_LNBITS_INVOICE_READ_KEY"

# Option 2: LND REST Node (alternative to LNbits)
LND_REST_URL="https://127.0.0.1:8080"
# Invoice macaroon only (create and look up invoices); never the admin macaroon
LND_MACAROON="YOUR_LND_INVOICE_MACAROON_HEX"

