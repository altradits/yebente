# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Safaricom Daraja API Configuration
# Options: "sandbox" or "production"
MPESA_ENVIRONMENT="sandbox"

# Daraja OAuth Credentials (obtain from developer.safaricom.co.ke)
MPESA_CONSUMER_KEY="YOUR_MPESA_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="YOUR_MPESA_CONSUMER_SECRET"

# Lipa Na M-Pesa Online (STK Push) Settings
# Default sandbox test shortcode is 174379
MPESA_SHORTCODE="174379"

# Official Safaricom Sandbox Passkey
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"

# Webhook Callback URL (accessible by Safaricom servers)
MPESA_CALLBACK_URL="https://example.com/api/mpesa/callback"
