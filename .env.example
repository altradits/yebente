# YeBente operator configuration. Copy to .env and fill in. Never commit .env.
# Everything here points at the operator's own infrastructure: a
# Bitcoin Core node, an LND node, and the owner-set rate. No company
# accounts are needed for the core app to run.

# Bitcoin Core RPC (the operator's own bitcoind)
BITCOIN_CORE_RPC_URL="http://127.0.0.1:8332"
BITCOIN_CORE_RPC_USER="yebente"
BITCOIN_CORE_RPC_PASSWORD="A_LONG_RANDOM_PASSWORD"

# LND REST (the operator's own node)
LND_REST_URL="https://127.0.0.1:8080"
# Invoice macaroon only (create and look up invoices); never the admin macaroon
LND_INVOICE_MACAROON="YOUR_LND_INVOICE_MACAROON_HEX"
# Pay macaroon (server-side payment path); leave empty to keep paying off
LND_PAY_MACAROON=""

# Owner-set rate: fiat per 1 BTC, major units (see docs/independence.md)
YEBENTE_OWNER_BTC_KES="13500000"
YEBENTE_OWNER_BTC_ETB="12000000"
YEBENTE_OWNER_BTC_USD="100000"
# Unix ms when these rates took effect (optional, defaults to now)
YEBENTE_OWNER_RATE_AT=""
